{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arc",
  "version": "0.1.4-beta.1",
  "identifier": "dev.arc.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arc",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4MDU3NjJFQTk4ODYwRDEKUldUUllJaXBMbllGK0haazM5U1hhTk92T09wRHhhaWVOT3M5ckwvSjQyV1pnYjNZV3llL1FETFcK",
      "endpoints": [
        "https://github.com/TibeDev/arc-editor/releases/latest/download/latest.json"
      ]
    }
  }
}
